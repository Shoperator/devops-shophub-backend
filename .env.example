# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shophub
DB_PASSWORD=shophub
DB_NAME=shophub
DB_SYNCHRONIZE=true

# Auth (JWT_SECRET is required, the app refuses to start without it)
JWT_SECRET=change-me-in-every-deployment
JWT_EXPIRES_IN=1h

# Where the shop sites are deployed and published
SHOP_NAMESPACE=default
SHOP_BASE_DOMAIN=shop.local

# Kubernetes. While this is not "true", shops are recorded but never deployed,
# which is what lets ShopHub run without a cluster.
KUBERNETES_ENABLED=false
KUBERNETES_AUTH_MODE=auto
KUBERNETES_FIELD_MANAGER=shophub
